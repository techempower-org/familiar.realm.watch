[Unit]
Description=llama.cpp coder — Qwen3-Coder-30B-A3B MoE on both GPUs (local Claude Code backend)
After=network.target mnt-ollama\x2dmodels.mount
Requires=mnt-ollama\x2dmodels.mount
# Owns BOTH P102s (19 GB resident) — cannot coexist with any GPU slot unit.
# Starting this stops the companion stack, and vice versa.
Conflicts=ollama-chat.service ollama-embed.service llama-server-extractor.service llama-server-extractor-gpu1.service llama-server-chat-gemma3-4b-gpu1.service llama-server-hyde-gemma3-4b-gpu1.service llama-server-reflect-qwen-3b-gpu1.service

[Service]
Type=simple
User=jp
Environment=CUDA_DEVICE_ORDER=PCI_BUS_ID
Environment=CUDA_VISIBLE_DEVICES=0,1
# Validated 2026-06-09: UD-Q3_K_XL is the largest quant that leaves room for
# the 128K context Claude Code needs (Q4_K_M only fits 16K — CC's opening
# request alone is ~43K tokens). q4_0 KV + flash-attn buy the window.
ExecStart=/opt/llama.cpp/build/bin/llama-server \
  --model /mnt/ollama-models/llama/models/Qwen3-Coder-30B-A3B-Instruct-UD-Q3_K_XL.gguf \
  --alias qwen3-coder \
  --port 8080 --host 0.0.0.0 \
  --jinja \
  -fa on \
  --cache-type-k q4_0 --cache-type-v q4_0 \
  --ctx-size 131072 \
  --parallel 1 \
  --n-gpu-layers 999 \
  --split-mode layer \
  --threads 8
Restart=on-failure
RestartSec=5
MemoryMax=12G
OOMScoreAdjust=-500

[Install]
WantedBy=multi-user.target
