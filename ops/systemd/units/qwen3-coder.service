[Unit]
# B60 ERA (2026-08-02): this lane moved off the two P102s onto the Arc Pro B60
# 24GB (Vulkan build at /opt/llama.cpp-vulkan), and the model went up a quant to
# UD-Q4_K_XL. This file had drifted badly from the host — it still described the
# dual-P102 CUDA config, the Q3_K_XL quant, and a 12G MemoryMax — so it was
# re-synced from /etc/systemd/system/qwen3-coder.service on 2026-08-19.
Description=Qwen3.6-35B-A3B UD-Q4_K_XL on the Arc Pro B60 (Vulkan) — Claude Code + HA lane
After=network-online.target b60-clocks.service
Wants=network-online.target
# NO Conflicts=. The "coder conflicts with every GPU slot" belief was false and
# is now actively wrong: the B60 and the surviving P102 do not contend, so the
# embed/chat slots on the P102 coexist with this lane by construction.
#
# b60-clocks ordering is load-bearing: a driver rebind resets the GT clocks to
# their default floor, and this lane's prefill throughput depends on the 2400
# min_freq pin. Verified still pinned (min=max=cur=act=2400) across three S3
# resume cycles on 2026-08-18/19.

[Service]
Type=simple
User=jp
# ---------------------------------------------------------------------------
# --parallel 1 (was 2, changed 2026-08-19)
# ---------------------------------------------------------------------------
# With --kv-unified, --parallel N does NOT partition the window — all N slots
# draw from ONE 131072-token KV pool. That is fine for two shallow chats and
# actively harmful for Claude Code, whose context runs to 110K+: a single Ember
# voice request landing on the second slot has to find its tokens in the same
# pool, so it evicts part of CC's prefix and the next CC turn pays a FULL cold
# re-prefill instead of a delta.
#
# That cold re-prefill is the whole problem, because prefill cost is superlinear
# in depth on this rig (measured 2026-08-19, live traffic):
#     3.6K prompt -> 928 t/s      9.4K -> 544 t/s      36K -> 246 t/s
# i.e. a 36K cold prefill costs 146 s, and extrapolating the curve a full
# 110K one costs 15-20 minutes — past API_TIMEOUT_MS=600000. Warm deltas on the
# same session cost 0.8-8.5 s (LCP similarity 0.974-1.000), so protecting the
# cache is worth far more than serving two requests at once.
#
# TRADEOFF, stated because it is not free: Ember's voice requests now QUEUE
# behind CC's main loop rather than running beside it. A long CC generation
# makes the voice assistant wait. If that becomes the bigger annoyance, the
# revert is --parallel 2 and living with the eviction.
#
# --kv-unified is retained but is a no-op at one slot; left in place so this is
# a one-variable change from the measured variant-A baseline.
#
# WHY NOT MORE CONTEXT: the model is natively 262144, but VRAM is the binding
# limit, not the model. Resident VRAM is already 22.25 GiB of 24 GB with
# ~486 MiB spilled to GTT, and KV(131K) + compute is only ~1.4 GiB of that.
# Doubling the window would load but push more into host memory over PCIe, and
# it would make the worst-case cold prefill dramatically worse — the opposite of
# what this lane needs. 131072 stays.
#
# Variant A (2026-08-08): --batch-size 2048 --ubatch-size 1024 => +27% prefill.
# Variant B (q4_0 KV) was TESTED AND REJECTED: -5% prefill, no decode gain.
# Variant C (2026-08-09): --cache-ram 12288 with MemoryMax 20G, to stop the
# prompt-cache evictions that were firing every few minutes.
#
# --jinja is MANDATORY: without it tool-calling silently breaks (the model falls
# back to a generic template and the tool JSON never fires).
# -fa on, not bare -fa: this build's flag takes on|off|auto and a bare -fa
# swallows the next argument.
# --device Vulkan0 is MANDATORY: NVIDIA also enumerates under Vulkan, and this
# model must never be split across the B60 and a P102.
ExecStart=/opt/llama.cpp-vulkan/build/bin/llama-server \
  --model /mnt/ollama-models/llama/models/Qwen3.6-35B-A3B-UD-Q4_K_XL.gguf \
  --alias qwen36-coder \
  --device Vulkan0 \
  --port 8091 --host 0.0.0.0 \
  --jinja \
  -fa on \
  --cache-type-k q8_0 --cache-type-v q8_0 \
  --ctx-size 131072 \
  --parallel 1 \
  --kv-unified \
  --batch-size 2048 --ubatch-size 1024 --metrics \
  --cache-ram 12288 \
  --n-gpu-layers 999 \
  --threads 8
Restart=on-failure
RestartSec=5
MemoryMax=20G
OOMScoreAdjust=-500

[Install]
WantedBy=multi-user.target
