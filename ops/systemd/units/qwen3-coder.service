[Unit]
Description=llama.cpp coder — Qwen3.6-35B-A3B MoE on both GPUs (local Claude Code backend)
After=network.target mnt-ollama\x2dmodels.mount
Requires=mnt-ollama\x2dmodels.mount
# Owns BOTH P102s (~19 GB resident) — cannot coexist with the GPU chat/extract
# slot units. Exception (2026-07-25): ollama-embed is allowed to coexist —
# Qwen3.6's small hybrid KV leaves ~860 MiB free on GPU1 and nomic-embed
# needs only ~321 MiB, so palace search stays up while the coder lane runs.
# The companion's chat routes to this server too (OLLAMA_CHAT_URL=:8091).
#
# 2026-07-29: llama-server-extractor.service REMOVED from Conflicts=.
# Conflicts= is symmetric, and both this unit and the extractor were
# WantedBy=multi-user.target, so systemd had to drop one of two conflicting
# boot jobs with no defined winner — an actual coin flip, observed live on
# 2026-07-28 (extractor up 22:44:07, stopped 22:44:48 when this unit started).
# It also left mempalace-kg-extract@11436 running against a dead :11436 for
# ~17.7 h. Rather than pick a winner, the extractor moved to CPU
# (llama-server-extractor.service.d/zz-cpu.conf, --n-gpu-layers 0), so it no
# longer contends for VRAM and the conflict is gone rather than arbitrated.
# Ember therefore wins the GPU by construction, not by luck, and unattended KG
# extraction keeps running. Every unit still listed below is GPU-resident and a
# genuine conflict; none of them is boot-enabled, which is what makes boot
# deterministic.
Conflicts=ollama-chat.service llama-server-extractor-gpu1.service llama-server-chat-gemma3-4b-gpu1.service llama-server-hyde-gemma3-4b-gpu1.service llama-server-reflect-qwen-3b-gpu1.service

[Service]
Type=simple
User=jp
Environment=CUDA_DEVICE_ORDER=PCI_BUS_ID
Environment=CUDA_VISIBLE_DEVICES=0,1
# 2026-07-24: swapped to Qwen3.6-35B-A3B (Apr 2026, 73.4% SWE-bench V). Same
# 3B-active MoE speed class as the old Qwen3-Coder-30B, but hybrid
# Gated-DeltaNet arch → only a fraction of layers carry full-attention KV, so
# the 128K window costs ~1-2GB instead of ~5GB. That headroom pays for the
# bigger weights (16.8G vs 12.9G) and lets KV run q8_0 instead of q4_0.
# CC's opening request alone is ~43K tokens — never serve this below 64K ctx.
ExecStart=/opt/llama.cpp/build/bin/llama-server \
  --model /mnt/ollama-models/llama/models/Qwen3.6-35B-A3B-UD-Q3_K_XL.gguf \
  --alias qwen36-coder \
  --port 8091 --host 0.0.0.0 \
  --jinja \
  -fa on \
  --cache-type-k q8_0 --cache-type-v q8_0 \
  --ctx-size 131072 \
  --parallel 2 \
  --kv-unified \
  --n-gpu-layers 999 \
  --split-mode layer \
  --threads 8
Restart=on-failure
RestartSec=5
MemoryMax=12G
OOMScoreAdjust=-500

[Install]
WantedBy=multi-user.target
