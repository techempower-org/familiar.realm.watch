[Unit]
Description=llama.cpp chat — Gemma 3 4B on GPU1 (slot picker variant)
After=network.target
# Gated to familiar-api lifecycle (2026-06-05): PartOf -> stop/restart follows
# familiar-api; WantedBy=familiar-api (see [Install]) -> starts with it. Companion
# models load only while the companion is up; nothing auto-starts at boot.
PartOf=familiar-api.service

[Service]
Type=simple
User=jp
Environment=CUDA_VISIBLE_DEVICES=1
ExecStart=/opt/llama.cpp/build/bin/llama-server \
  --model /var/cache/llama/models/gemma-4-E4B-it-Q4_K_M.gguf \
  --port 11438 --host 0.0.0.0 \
  --n-gpu-layers 999 \
  --ctx-size 8192 \
  --parallel 1 \
  --threads 8 \
  --cont-batching \
  --alias gemma3-4b
Restart=on-failure
RestartSec=5
MemoryMax=3G
OOMScoreAdjust=-500

[Install]
WantedBy=familiar-api.service
