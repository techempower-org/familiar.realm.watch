# /var/lib/familiar/allowed-units.txt
#
# Unit names familiar-slotctl is permitted to start/stop/restart/probe.
# One unit per line; # comments allowed. The wrapper rejects anything
# not on this list, AND anything not matching ^[a-z0-9-]+\.service$.
#
# This list is ops-owned and should be regenerated whenever registry.json
# adds or removes a variant. The intent is that every variant.unit value
# in registry.json appears here exactly once.

# Currently-deployed units (refreshed 2026-08-09 for the B60 era:
# extractor-gpu1 and ollama-chat removed with their registry variants —
# the second P102 left with the B60 install; see registry.json.example)
llama-server-extractor.service
ollama-embed.service

# Slot picker units (see ops/systemd/units/)
llama-server-chat-gemma3-4b-gpu1.service
llama-server-chat-gemma3-4b-cpu.service
llama-server-hyde-gemma3-4b-gpu1.service
llama-server-reflect-qwen-3b-gpu1.service

# Local Claude Code backend (B60/Vulkan since 2026-08; no Conflicts= — slot units are CUDA/P102, no contention)
qwen3-coder.service
