+def _save_utterance(save_dir, keep, audio_bytes, sample_rate, transcript):
+    """Tee one utterance to disk: exactly the bytes HA forwarded from the
+    satellite's mic, 16-bit mono, plus a sidecar .txt with what the model made
+    of them. This is 'what Ember hears' for debugging mic gain, clipped first
+    words and VAD cutoffs — enabled by --save-audio, pruned to --save-audio-keep
+    newest so it can run indefinitely without eating the disk."""
+    import wave, glob
+    try:
+        os.makedirs(save_dir, exist_ok=True)
+        ts = time.strftime("%Y%m%d-%H%M%S")
+        base = os.path.join(save_dir, f"utt-{ts}")
+        n = 0
+        path = f"{base}.wav"
+        while os.path.exists(path):
+            n += 1
+            path = f"{base}-{n}.wav"
+        with wave.open(path, "wb") as w:
+            w.setnchannels(1)
+            w.setsampwidth(2)
+            w.setframerate(sample_rate)
+            w.writeframes(bytes(audio_bytes))
+        with open(path.replace(".wav", ".txt"), "w") as f:
+            f.write(transcript or "")
+        wavs = sorted(glob.glob(os.path.join(save_dir, "utt-*.wav")))
+        for old in wavs[:-keep]:
+            for ext in (old, old.replace(".wav", ".txt")):
+                try:
+                    os.remove(ext)
+                except OSError:
+                    pass
+    except Exception as e:  # a debug tap must never kill transcription
+        LOG.warning("save-audio failed: %s", e)
+
