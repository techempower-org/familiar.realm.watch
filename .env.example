# familiar-api configuration (v0.1)
# Copy to .env for local dev; real secrets come from vault in prod.

# HTTP server
FAMILIAR_PORT=8080
FAMILIAR_HOST=0.0.0.0

# Ollama endpoints
OLLAMA_CHAT_URL=http://127.0.0.1:11434
OLLAMA_EMBED_URL=http://127.0.0.1:11435
OLLAMA_CHAT_MODEL=qwen2.5:3b-instruct-q4_K_M
OLLAMA_EMBED_MODEL=nomic-embed-text:v1.5

# palace-daemon
PALACE_DAEMON_URL=http://disks:8085
PALACE_DAEMON_API_KEY=
PALACE_SEARCH_TIMEOUT_MS=2000

# Memory protocol
# Retrieval channel (issue #88). Picks which daemon search endpoint drives
# grounding:
#   age-fused (default) — POST /search/age-fused: vector ⊕ Apache-AGE
#       knowledge-graph walk (RRF). The ONLY path that lets the populated KG
#       reach end users; "hybrid" and "vector" bypass the graph. Falls back
#       to vector /search on a daemon without the endpoint (404/503).
#   hybrid    — POST /search/hybrid: vector + BM25 + graph candidate fusion.
#   vector    — GET /search: legacy vector-only path.
PALACE_SEARCH_MODE=age-fused
# Modality-aware retrieval weighting (issue #44): biases search results
# toward rooms whose content shape fits the query intent (detail vs
# synthesis). Set to "off", "false", or "0" to disable for ablation.
PALACE_MODALITY_WEIGHT=on
TOKEN_BUDGET_SYSTEM=1500
TOKEN_BUDGET_CONTEXT=4000
TOKEN_BUDGET_HISTORY=2000
TOKEN_BUDGET_RESPONSE=512
RETRIEVAL_LIMIT=5

# Session store
SESSION_TTL_MINUTES=60

# Sigil
REALM_SIGIL_REALM=fantasy

# Logging
LOG_LEVEL=info
